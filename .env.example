AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Optional estimated pricing in USD per 1M tokens. Leave blank to show tokens only.
AZURE_INPUT_COST_PER_1M_TOKENS=
AZURE_OUTPUT_COST_PER_1M_TOKENS=

# Additional retries for Azure rate-limit responses. -1 waits and continues until success.
TRANSIT_LLM_MAX_RETRIES=-1

# GitHub App installation access for repository intake and migration branch export.
# The token/App needs Contents: Read and write on the target repository.
# Prefer these values in production. GITHUB_TOKEN is a local-development fallback.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=""
GITHUB_TOKEN=
