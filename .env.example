AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# GitHub App installation access for repository intake and migration branch export.
# The token/App needs Contents: Read and write on the target repository.
# Prefer these values in production. GITHUB_TOKEN is a local-development fallback.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=""
GITHUB_TOKEN=
